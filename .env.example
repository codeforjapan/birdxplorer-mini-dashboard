# ── BirdXplorer REST API（認証不要）──
# 本番エンドポイントの有無は docs/spec.md §9-1 の確認事項。
BIRDXPLORER_API_BASE=https://dev.api-birdxplorer.code4japan.org

# ── OpenRouter ──
# キーは https://openrouter.ai/settings/keys で発行する。
# モデルは Google 直配信・structured outputs 対応・GA 済みのものを選定済み。
# preview 系IDは1ヶ月の無人運用中に消える恐れがあるため使わない。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ── cron 保護 ──
# `openssl rand -hex 32` で生成。Vercel cron 以外からの実行を弾くために使う。
CRON_SECRET=
# 振り分け役（/api/cron/dispatch/*）が作業ルートを呼ぶ先。本番のカスタムドメインを入れる
# （デプロイ固有 URL は Deployment Protection で弾かれる）。
CRON_SELF_ORIGIN=

# ── Vercel Blob（公開スナップショットの書き出し先）──
# Vercel ダッシュボードの Storage で Blob store を作成すると発行される。
#
# 重要: store は必ず **public アクセス**で作成すること。
# アクセスモードは作成時に固定され、後から変更できない。private store に対して
# put({ access: "public" }) を呼ぶと "Cannot use public access on a private store"
# で全ての書き出しが失敗する。誤って private で作った場合は store を作り直す。
BLOB_READ_WRITE_TOKEN=

# ── Neon Postgres（ノート・クラスタ・状態のすべて。唯一の真実）──
# Vercel Marketplace の Neon 統合、または https://neon.com で作成する。
# serverless driver は HTTP 経由で接続するため、プーラ側の接続文字列
# （ホスト名に `-pooler` を含むもの）を使う。
DATABASE_URL=


# ── 事例（テナント）の振り分け ──
# 事例をサブドメインに持つ親ドメイン。{slug}.<親ドメイン> で事例を引く（直下1階層のみ・www は対象外）。
TENANT_PARENT_DOMAIN=
# ホスト名 → slug の別名（JSON）。旧 .vercel.app やローカル開発用。例 {"localhost":"demo"}
TENANT_HOST_ALIASES=

# ── Searchlight 連携（任意。4つとも未設定なら無効）──
# 事例ごとの topic ID は環境変数ではなく事例設定（searchlightTopicId）に持つ。
SEARCHLIGHT_BASE_URL=
SEARCHLIGHT_CLIENT_ID=
SEARCHLIGHT_CLIENT_SECRET=
SEARCHLIGHT_COMPANY_ID=
